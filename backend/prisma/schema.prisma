generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Deck {
  id          String   @id
  name        String
  type        String   @default("builtin")
  icon        String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cards  Card[]
  limits DeckDailyLimit[]
}

model Card {
  id          String   @id
  deckId      String
  type        String   @default("qa")
  number      Int?
  title       String?
  titleCn     String?
  question    String?
  answer      String?
  description String?
  approach    String?
  difficulty  String?
  tags           String?
  searchKeywords String?
  subTopic       String?
  source         String?
  codes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deck     Deck           @relation(fields: [deckId], references: [id])
  progress CardProgress[]
  logs     ReviewLog[]
}

model CardProgress {
  userId         String
  cardId         String
  state          String   @default("new")
  easeFactor     Float    @default(2.5)
  intervalDays   Int      @default(0)
  repetitions    Int      @default(0)
  lapses         Int      @default(0)
  nextReview     DateTime @default(now())
  lastReviewedAt DateTime?
  favorited      Boolean  @default(false)
  userNotes      String?

  card Card @relation(fields: [cardId], references: [id])

  @@id([userId, cardId])
}

model ReviewLog {
  id               String   @id
  userId           String
  cardId           String
  reviewedAt       DateTime
  rating           Int
  stateBefore      String
  stateAfter       String
  intervalBefore   Int
  intervalAfter    Int
  easeBefore       Float
  easeAfter        Float
  repetitionsBefore Int @default(0)
  repetitionsAfter  Int @default(0)
  lapsesBefore      Int @default(0)
  lapsesAfter       Int @default(0)
  nextReviewBefore  DateTime?
  nextReviewAfter   DateTime?
  elapsedDays      Float
  scheduledDays    Int

  card Card @relation(fields: [cardId], references: [id])

  @@index([userId, reviewedAt])
  @@index([userId, cardId, reviewedAt])
}

model DeckDailyLimit {
  userId     String
  deckId     String
  dailyLimit Int    @default(20)

  deck Deck @relation(fields: [deckId], references: [id])

  @@id([userId, deckId])
}

// ============ Document-to-Flashcards v1 ============

model DocumentSource {
  id         String   @id @default(cuid())
  filename   String
  fileType   String
  fileSize   Int
  filePath   String
  status     String   @default("uploaded")
  parseError String?
  createdAt  String?
  updatedAt  String?

  blocks DocumentBlock[]
  chunks DocumentChunk[]
}

model DocumentBlock {
  id           String  @id @default(cuid())
  documentId   String
  pageNumber   Int?
  sectionPath  String?
  type         String
  text         String
  bboxJson     String?
  source       String
  confidence   Float?
  orderIndex   Int

  document DocumentSource @relation(fields: [documentId], references: [id])

  @@index([documentId, orderIndex])
}

model DocumentChunk {
  id            String  @id @default(cuid())
  documentId    String
  title         String?
  text          String
  blockIdsJson  String  @default("[]")
  sourceRefsJson String @default("[]")
  tokenCount    Int?
  orderIndex    Int

  document DocumentSource @relation(fields: [documentId], references: [id])

  @@index([documentId, orderIndex])
}

model ExtractedConcept {
  id              String  @id @default(cuid())
  documentId      String
  chunkId         String
  conceptName     String
  normalizedName  String?
  definition      String?
  keyPointsJson   String  @default("[]")
  examplesJson    String?
  formulasJson    String?
  prerequisitesJson String?
  commonConfusionsJson String?
  candidateTagsJson String  @default("[]")
  graphMatchJson  String?
  confidence      Float
  sourceRefsJson  String  @default("[]")

  createdAt String?

  @@index([documentId])
  @@index([chunkId])
}

model CardDraft {
  id               String   @id @default(cuid())
  documentId       String?
  chunkId          String?
  conceptId        String?
  type             String   @default("concept")
  question         String
  answer           String
  tagsJson         String   @default("[]")
  searchKeywordsJson String @default("[]")
  canonicalTopic   String?
  graphNodeId      String?
  graphStatus      String?
  confidence       Float    @default(1.0)
  status           String   @default("draft")
  canonicalConcept String?
  learningObjective String?  // definition | principle | procedure | formula | comparison | application | example | pitfall
  atomicFactsJson  String?   // JSON array of atomic fact statements
  answerScope      String?   // scope/angle of the answer
  duplicateCheckJson String?
  duplicateGroupId String?    // group ID for grouped review
  sourceRefsJson   String   @default("[]")
  reviewNote       String?
  importedCardId   String?
  deckId           String?
  createdAt        String?
  updatedAt        String?

  reviews CardDraftReview[]

  @@index([documentId])
  @@index([status])
}

model CardDraftReview {
  id         String   @id @default(cuid())
  draftId    String
  action     String   // approve | edit | reject | mark_duplicate | merge | mark_out_of_scope
  beforeJson String?  // snapshot before action
  afterJson  String?  // snapshot after action
  note       String?
  createdAt  String?

  draft CardDraft @relation(fields: [draftId], references: [id])

  @@index([draftId])
}

// ============ Phase 2: Agent 相关新增表 ============

// Replaced by Document-to-Flashcards CardDraft below

model JobPrepSession {
  id           String   @id
  state        String   @default("awaiting_company")
  company      String?
  role         String?
  location     String?
  targetDays   Int?
  dailyMinutes Int?
  jdSource     String?
  jdText       String?
  jdSourceUrl  String?
  jobProfile   String?
  cardMatches  String?
  studyPlan    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StudyQueue {
  id        String   @id
  source    String   @default("normal")
  title     String
  cardIds   String
  planId    String?
  createdAt DateTime @default(now())
}

model EmbeddingRecord {
  id          String   @id
  objectType  String
  objectId    String
  provider    String
  model       String
  dimension   Int
  vectorStore String   @default("sqlite-vec")
  vectorTable String
  vectorRowId Int
  status      String   @default("active")
  textHash    String
  createdAt   DateTime @default(now())

  @@unique([objectType, objectId, model])
}

// ============ 学习计划 ============

model LearningPlan {
  id        String   @id @default(cuid())
  userId    String   @default("demo-user")
  title     String
  query     String
  items     String   // JSON: [{cardId, deckId, titleCn}]
  studyPlan String?  // LLM 生成的文本计划
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============ API 配置 ============

model AppConfig {
  key   String @id
  value String
}

// ============ 搜索 topic 词典（从 Card.tags 聚合） ============

model SearchTopic {
  id        String   @id @default(cuid())
  name      String   @unique    // canonical topic name, e.g., "数组"
  deckHint  String?            // suggested deck, e.g., "leetcode"
  keywords  String              // JSON array of expansion keywords
  subtopics String              // JSON array of subtopics
  tagCount  Int      @default(0) // how many cards have tags matching this topic
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}
