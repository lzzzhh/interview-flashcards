generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Deck {
  id          String   @id
  name        String
  type        String   @default("builtin")
  icon        String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cards  Card[]
  limits DeckDailyLimit[]
}

model Card {
  id          String   @id
  deckId      String
  type        String   @default("qa")
  number      Int?
  title       String?
  titleCn     String?
  question    String?
  answer      String?
  description String?
  approach    String?
  difficulty  String?
  tags           String?
  searchKeywords String?
  subTopic       String?
  source         String?
  codes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deck     Deck           @relation(fields: [deckId], references: [id])
  progress CardProgress[]
  logs     ReviewLog[]
}

model CardProgress {
  userId         String
  cardId         String
  state          String   @default("new")
  easeFactor     Float    @default(2.5)
  intervalDays   Int      @default(0)
  repetitions    Int      @default(0)
  lapses         Int      @default(0)
  nextReview     DateTime @default(now())
  lastReviewedAt DateTime?
  favorited      Boolean  @default(false)
  userNotes      String?

  card Card @relation(fields: [cardId], references: [id])

  @@id([userId, cardId])
}

model ReviewLog {
  id               String   @id
  userId           String
  cardId           String
  reviewedAt       DateTime
  rating           Int
  stateBefore      String
  stateAfter       String
  intervalBefore   Int
  intervalAfter    Int
  easeBefore       Float
  easeAfter        Float
  repetitionsBefore Int @default(0)
  repetitionsAfter  Int @default(0)
  lapsesBefore      Int @default(0)
  lapsesAfter       Int @default(0)
  nextReviewBefore  DateTime?
  nextReviewAfter   DateTime?
  elapsedDays      Float
  scheduledDays    Int

  card Card @relation(fields: [cardId], references: [id])

  @@index([userId, reviewedAt])
  @@index([userId, cardId, reviewedAt])
}

model DeckDailyLimit {
  userId     String
  deckId     String
  dailyLimit Int    @default(20)

  deck Deck @relation(fields: [deckId], references: [id])

  @@id([userId, deckId])
}

// ============ Phase 2: Agent 相关新增表 ============

model CardDraft {
  id           String   @id
  sourceId     String?
  deckId       String
  type         String   @default("qa")
  question     String
  answer       String
  tags         String?
  difficulty   String?
  subTopic     String?
  reason       String?
  qualityScore Float?
  status       String   @default("draft")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SourceDocument {
  id         String   @id
  fileName   String?
  sourceType String
  parser     String
  fullText   String
  metadata   String?
  textHash   String
  createdAt  DateTime @default(now())
  chunks     SourceChunk[]
}

model SourceChunk {
  id         String   @id
  sourceId   String
  chunkIndex Int
  text       String
  tokenCount Int?
  hash       String
  source     SourceDocument @relation(fields: [sourceId], references: [id])
}

model JobPrepSession {
  id           String   @id
  state        String   @default("awaiting_company")
  company      String?
  role         String?
  location     String?
  targetDays   Int?
  dailyMinutes Int?
  jdSource     String?
  jdText       String?
  jdSourceUrl  String?
  jobProfile   String?
  cardMatches  String?
  studyPlan    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StudyQueue {
  id        String   @id
  source    String   @default("normal")
  title     String
  cardIds   String
  planId    String?
  createdAt DateTime @default(now())
}

model EmbeddingRecord {
  id          String   @id
  objectType  String
  objectId    String
  provider    String
  model       String
  dimension   Int
  vectorStore String   @default("sqlite-vec")
  vectorTable String
  vectorRowId Int
  status      String   @default("active")
  textHash    String
  createdAt   DateTime @default(now())

  @@unique([objectType, objectId, model])
}

// ============ 学习计划 ============

model LearningPlan {
  id        String   @id @default(cuid())
  userId    String   @default("demo-user")
  title     String
  query     String
  items     String   // JSON: [{cardId, deckId, titleCn}]
  studyPlan String?  // LLM 生成的文本计划
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============ API 配置 ============

model AppConfig {
  key   String @id
  value String
}
