{
  "name": "flashcards-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "evaluate": "tsx src/evaluation/runner.ts",
    "evaluate:validate": "tsx src/evaluation/validate.ts",
    "evaluate:v8-ablation": "tsx src/evaluation/v8-ablation-runner.ts",
    "evaluate:gate": "tsx src/evaluation/release-gate.ts",
    "evaluate:smoke-new-cards": "tsx src/evaluation/smoke-new-cards.ts",
    "readiness:check": "tsx src/ingestion/readiness-cli.ts check",
    "readiness:fix": "tsx src/ingestion/readiness-cli.ts fix",
    "readiness:fix-all": "tsx src/ingestion/readiness-cli.ts fix-all",
    "readiness:gaps": "tsx src/ingestion/readiness-cli.ts gaps",
    "readiness:audit": "tsx src/ingestion/readiness-cli.ts audit",
    "graph:import-neo4j": "tsx src/scripts/import-concept-graph-neo4j.ts",
    "evaluate:neo4j-gate": "tsx src/evaluation/neo4j-release-gate.ts",
    "evaluate:neo4j-best": "tsx src/evaluation/neo4j-release-gate.ts",
    "evaluate:neo4j-gate-v2": "tsx src/evaluation/neo4j-release-gate-v2.ts",
    "evaluate:neo4j-gate-v3": "tsx src/evaluation/neo4j-release-gate-v3.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@prisma/client": "^6.0.0",
    "fastify": "^5.0.0",
    "neo4j-driver": "^5.28.3",
    "pdfjs-dist": "^3.11.174",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
