# ============================================================
# 面经闪卡后端环境变量
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================================

# 数据库
# SQLite 自动创建（开发环境）：file:../data/flashcards.db
DATABASE_URL="file:./data/flashcards.db"

# 服务器端口
PORT=3001

# ============================================================
# LLM 配置（用于 AI 制卡、JD 分析、语义搜索）
# 支持任何 OpenAI 兼容 API（OpenAI / DeepSeek / 自定义）
# ============================================================

# LLM API 地址（不含 /v1/chat/completions 路径）
LLM_BASE_URL="https://api.openai.com"

# LLM API Key
LLM_API_KEY="sk-your-api-key"

# Chat 模型
LLM_MODEL="gpt-4o-mini"

# Guard Agent — 用于岗位备战计划质量检查的廉价模型
# 使用与主 LLM 相同的 baseUrl 和 apiKey，仅切换 model
LLM_GUARD_MODEL="deepseek-flash"

# ============================================================
# Embedding 配置（用于向量搜索）
# 支持任何 OpenAI 兼容 Embedding API
# ============================================================

# Embedding 模型
EMBEDDING_MODEL="text-embedding-3-small"

# ============================================================
# Python 文档解析 Worker
# ============================================================

# Worker 地址（默认本地）
PARSER_WORKER_URL="http://localhost:8000"

# ============================================================
# Neo4j 知识图谱（用于图谱增强搜索，可选）
# docker compose -f docker-compose.neo4j.yml up -d
# ============================================================

GRAPH_NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ============================================================
# Qdrant RAG 向量数据库（岗位备战功能必需依赖）
# docker compose -f docker-compose.qdrant.yml up -d
# ============================================================

QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=interview_flashcards_rag_chunks
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine
QDRANT_COMPOSE_FILE=docker-compose.qdrant.yml
QDRANT_START_TIMEOUT_MS=30000

# Embedding（用于 Qdrant 向量写入与语义召回）
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
